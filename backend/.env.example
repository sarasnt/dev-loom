# DevLoom backend — example environment. COPY to `.env` (gitignored) and fill in real values.
# NEVER put real secrets in this file — it is committed. Real secrets go in `.env` only.

# ---- database (defaults match docker-compose) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devloom
SPRING_DATASOURCE_USERNAME=devloom
SPRING_DATASOURCE_PASSWORD=devloom

# ---- Jira (ON-PREMISES / Data Center — NOT Jira Cloud) ----
# On-prem Jira uses a Personal Access Token via `Authorization: Bearer <token>`
# and REST API v2 (/rest/api/2/...). This differs from Jira Cloud's OAuth 3LO.
DEVLOOM_JIRA_BASE_URL=https://jira.critical.pt
DEVLOOM_JIRA_AUTH=pat
DEVLOOM_JIRA_PAT=__put_your_rotated_jira_personal_access_token_here__

# ---- GitHub ----
# MVP: a fine-grained PAT (read-only) is simplest for a single user; GitHub App later.
DEVLOOM_GITHUB_BASE_URL=https://api.github.com
DEVLOOM_GITHUB_TOKEN=__github_fine_grained_read_token__

# ---- Notion (Next scope) ----
# Notion's API is cloud-based (internal integration token from notion.so/my-integrations).
# "Installed locally" (desktop app) has no local API — see docs/handover for options.
DEVLOOM_NOTION_TOKEN=__notion_internal_integration_token__

# ---- AI providers ----
DEVLOOM_AI_PROVIDER=stub                 # stub | ollama | anthropic | openai
DEVLOOM_OLLAMA_URL=http://localhost:11434
DEVLOOM_AI_MODEL=Qwen3-Coder-30B-A3B
# Optional BYO keys (leave blank for local-only):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- observability ----
DEVLOOM_LANGFUSE_ENABLED=false
